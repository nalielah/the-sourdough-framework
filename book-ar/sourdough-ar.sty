\AtBeginDocument{%
  \renewcommand*{\scr@tso@chapter@numberformat}[1]{\LR{#1}}%
  \renewcommand*{\scr@tso@section@numberformat}[1]{\LR{#1}}%
  \renewcommand*{\scr@tso@subsection@numberformat}[1]{\LR{#1}}%
  \renewcommand*{\scr@tso@subsubsection@numberformat}[1]{\LR{#1}}%
  \renewcommand*{\scr@tso@figure@numberformat}[1]{\LR{#1}}%
  \renewcommand*{\scr@tso@table@numberformat}[1]{\LR{#1}}%
  \renewcommand*{\scr@tso@flowchart@numberformat}[1]{\LR{#1}}%
}

% ---------------------------------------------------------------- RTL tables
% Cell bodies start in TRT direction: the RTL table-mirror convention keeps
% columns declared in visual left-to-right order with labels rightmost,
% while each cell's Arabic text flows right-to-left. \qty cells are wrapped
% in \LR{} islands at the source level. Patched without \makeatletter (a
% .sty has @ as a letter already).
\patchcmd{\insert@column}%
  {\ignorespaces \@sharp \unskip}%
  {\ignorespaces \@sharp \unskip \textdir TRT}%
  {}{\PackageError{sourdough-ar}{\string\insert@column\space patch failed (array.sty changed?)}{}}

