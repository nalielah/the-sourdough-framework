% ------------------------------------------------- Western digits, LTR-safe
% Patch polyglossia's \arabicnumber: under numerals=maghrib the western
% branch emitted bare Western digits into RTL context, which the bidi
% algorithm stores right-to-left (page numbers read "01" for "10"). Wrap
% both branches in \@ensure@LTR so counters, page numbers and dates keep
% LTR digit order everywhere.
\renewcommand{\arabicnumber}[1]{%
  \ifeastern@numerals
    \@ensure@LTR{\arabicdigits{\number#1}}%
  \else
    \@ensure@LTR{\number#1}%
  \fi}

% ----------------------------------------------------------- caption style
\KOMAoptions{captions=nooneline}

% --------------------------------------------------- Lua digit post-filter
% arabic-digits.lua: (1) post_linebreak_filter reversing bare Western-digit
% runs stored RTL by the bidi algorithm inside TRT lines; (2) remap of
% ASCII digits, letters and units punctuation landing in an Arabic font
% onto size-matched TeX Gyre Pagella (RATIO 433/469), hlist AND vlist
% recursion, style-matched. Loaded from the build directory.
\directlua{dofile("arabic-digits.lua")}

% --------------------------------------------------------------- TikZ fix
% Flowchart node text stays LTR; Arabic labels inside nodes are wrapped in
% \textarabic{} at the figure level. The font override drops \sffamily so
% node text matches body weight.
\AddToHook{env/tikzpicture/begin}{\setLTR}
\tikzset{every picture/.append style={font=\footnotesize}}

% ------------------------------------------------------ dotted numbers, LTR
% Section/figure/table numbers and the chapter number everywhere it is
% typeset must read left-to-right inside the RTL page.
\renewcommand*{\sectionformat}{\LR{\thesection\autodot}}
\renewcommand*{\subsectionformat}{\LR{\thesubsection\autodot}}
\renewcommand*{\subsubsectionformat}{\LR{\thesubsubsection\autodot}}
\renewcommand*{\figureformat}{\LR{\thefigure\autodot}}
\renewcommand*{\tableformat}{\LR{\thetable\autodot}}
% Flowchart caption: keep KOMA's default label (\flowchartname~number) and
% wrap only the number in \LR{}, mirroring the figureformat mechanism.
% Wrapping the number alone is essential: without it the @ensure@LTR
% \LRE-fragments reverse around the bare dot in the RTL caption line,
% rendering "2.1" for logical 1.2 (R2 pipeline ruling 2026-11-15, Route
% (a) authorized). The name is KEPT: the KOMA default \flowchartformat
% includes it, the delivered unit 8 build showed it, and the accepted
% edition renders it («المخطط الانسيابي 6.1:», Amiri-Bold).
\renewcommand*{\flowchartformat}{\flowchartname~\LR{\theflowchart\autodot}}
\renewcommand*{\chaptermarkformat}{\LR{\thechapter\autodot}\enskip}

